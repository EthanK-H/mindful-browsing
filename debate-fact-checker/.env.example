# Required — powers claim extraction and fact-checking
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables live microphone transcription (demo mode works without it)
ASSEMBLYAI_API_KEY=

# Optional
PORT=3000

# Optional — only if one IP family is broken on your network and API calls
# keep timing out: ipv4first or ipv6first
# DNS_ORDER=ipv4first

# Optional — override which Claude models each stage uses.
# Defaults (used if left unset): extraction=claude-haiku-4-5, fact-check=claude-sonnet-5
EXTRACTION_MODEL=claude-haiku-4-5
FACTCHECK_MODEL=claude-sonnet-5
